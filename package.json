{
  "name": "governed-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A governed MCP gateway for an assistant, with saved evals. Synthetic data only.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/server.ts",
    "approve": "tsx scripts/approve.ts",
    "evals": "tsx evals/run.ts",
    "evals:mutants": "tsx evals/mutants.ts",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "export": "tsx scripts/export-dashboard.ts",
    "test": "npm run typecheck && npm run evals && npm run evals:mutants && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
